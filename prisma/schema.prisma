generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserUsage {
  id                String   @id @default(uuid())
  userId            String   @unique
  aiGenerationsUsed Int      @default(0)
  aiLimit           Int      @default(5)
  maxHabits         Int      @default(10)
  canUseVoice       Boolean  @default(false)
  lastReset         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String         @id @default(uuid())
  email                String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  clerkUserId          String         @unique
  firstName            String?
  imageUrl             String?
  lastName             String?
  role                 Role           @default(USER)
  habits_clerk_user_id String?        @unique
  habits_linked_at     DateTime?
  habits_user_id       String?        @unique
  categories           Category[]
  monthHistory         MonthHistory[]
  transactions         Transaction[]
  settings             UserSettings?
  usage                UserUsage?
  yearHistory          YearHistory[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  accountLinkConfirmations AccountLinkConfirmation[]
}

model OAuthClient {
  id           String   @id @default(uuid())
  clientId     String   @unique
  clientSecret String
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens      OAuthAccessToken[]
}

model OAuthAuthorizationCode {
  id            String   @id @default(uuid())
  code          String   @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id])
  userId        String
  user          User @relation(fields: [userId], references: [id])
  redirectUri   String
  scopes        String[]
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([expiresAt])
}

model OAuthAccessToken {
  id              String   @id @default(uuid())
  accessToken     String   @unique
  refreshToken    String   @unique
  clientId        String
  client          OAuthClient @relation(fields: [clientId], references: [id])
  userId          String
  user            User @relation(fields: [userId], references: [id])
  scopes          String[]
  accessExpiresAt DateTime
  refreshExpiresAt DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
}

model AccountLinkConfirmation {
  id              String   @id @default(uuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  requestingApp   String
  requestClientId String
  scopes          String[]
  redirectUri     String
  state           String
  status          String   @default("pending")
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([token])
  @@index([userId, status])
}

model UserSettings {
  currency  String
  userId    String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  createdAt    DateTime      @default(now())
  name         String
  type         String        @default("income")
  icon         String
  userId       String
  id           String        @id @default(uuid())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([name, userId, type])
}

model Transaction {
  id                 String              @id @default(uuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  amount             Float
  description        String
  date               DateTime
  userId             String
  type               String              @default("income")
  categoryIcon       String
  categoryId         String
  isRecurring        Boolean             @default(false)
  paymentMethod      PAYMENTMETHOD?
  receiptUrl         String?
  recurrenceInterval RECURRENCEINTERVAL?
  nextRecurringDate  DateTime?
  sourceApp          String?
  sourceRefId        String?
  sourceRefLabel     String?
  category           Category            @relation(fields: [categoryId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceApp, sourceRefId])
}

model MonthHistory {
  day     Int
  month   Int
  year    Int
  income  Float
  expanse Float
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, month, year, userId])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  income  Float
  expanse Float
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([month, year, userId])
}

enum Role {
  USER
  ADMIN
  STARTER
  PREMIUM
}

enum TYPES {
  EXPANSE
  INCOME
}

enum RECURRENCEINTERVAL {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PAYMENTMETHOD {
  CARD
  BANK_TRANSFER
  MOBILE_PAYMENT
}
